{
  "name": "@dev.fast/review-canvas",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build --config desktop.vite.config.ts",
    "pretest": "pnpm --filter @dev.fast/whiteboard ensure:tutorial-assets",
    "test": "vitest run --config vitest.config.ts",
    "test:node": "vitest run --config vitest.config.ts --project canvas-node",
    "test:browser": "vitest run --config vitest.config.ts --project browser",
    "test:browser:watch": "vitest --config vitest.config.ts --project browser --browser.headless=false",
    "typecheck": "pnpm -w exec tsc --noEmit -p packages/review/app",
    "pretest:node": "pnpm --filter @dev.fast/whiteboard ensure:tutorial-assets",
    "pretest:browser": "pnpm --filter @dev.fast/whiteboard ensure:tutorial-assets",
    "pretypecheck": "pnpm --filter @dev.fast/whiteboard ensure:tutorial-assets"
  },
  "dependencies": {
    "@dev.fast/review-protocol": "workspace:*",
    "@dev.fast/whiteboard": "workspace:*",
    "@mr_mint/elkjs-libavoid": "0.5.0",
    "@speed-highlight/core": "1.2.15",
    "@tanstack/react-table": "8.21.3",
    "@xyflow/react": "12.10.2",
    "decode-named-character-reference": "1.3.0",
    "elkjs": "0.11.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.11",
    "hono": "4.13.5",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
