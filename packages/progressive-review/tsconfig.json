{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // ES2025 for iterator helpers; the runtime floor is Node 24
    // (package.json engines), tsdown targets node24, and the app ships in
    // Electron 42 (Chromium 140).
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "app/src",
    "app/desktop.vite.config.ts",
    "scripts",
    "vitest.config.ts"
  ]
}
