{
  "name": "review-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Review Desktop monorepo",
  "license": "MIT",
  "scripts": {
    "dev": "REVIEW_DESKTOP_DEV_FAST=1 pnpm desktop:build && pnpm desktop:run",
    "clean": "node scripts/clean-review-desktop.mjs",
    "desktop:build": "pnpm --filter @dev-fast/review-desktop app:build",
    "desktop:run": "pnpm --filter @dev-fast/review-desktop app:run",
    "desktop:watch": "pnpm --filter @dev-fast/review-desktop app:watch",
    "desktop:package:linux": "pnpm --filter @dev-fast/review-desktop app:package:linux",
    "review": "pnpm --filter @dev.fast/review review",
    "format": "oxfmt --write \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"!apps/review-desktop/code-oss/**\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"*.json\" \".*.json\"",
    "format:check": "oxfmt --check \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"!apps/review-desktop/code-oss/**\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"*.json\" \".*.json\"",
    "lint": "oxlint --disable-nested-config .",
    "ci": "pnpm --filter @dev.fast/review check:tutorial && pnpm --filter @dev-fast/review-desktop app:build && pnpm --filter @dev-fast/review-desktop test && npm --prefix apps/review-desktop/code-oss run test-review-harness",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "npm:@typescript/typescript6@6.0.1",
    "typescript-7": "npm:typescript@7.0.1-rc"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.1.2"
}
