{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // ES2024 for Promise.withResolvers; the runtime floor is Node 24
    // (package.json engines) and tsdown targets node24.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "app/src",
    "app/desktop.vite.config.ts",
    "scripts",
    "vitest.config.ts"
  ]
}
