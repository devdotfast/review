{
  "name": "@dev.fast/whiteboard-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Whiteboard Desktop monorepo",
  "license": "MIT",
  "scripts": {
    "dev": "WHITEBOARD_DESKTOP_DEV_FAST=1 pnpm desktop:build && pnpm desktop:run",
    "dev:background": "DEV_FAST_WHITEBOARD_DESKTOP_BACKGROUND=1 pnpm dev",
    "clean": "node scripts/clean-whiteboard-desktop.mjs",
    "desktop:build": "pnpm --filter @dev.fast/whiteboard-desktop app:build",
    "desktop:run": "pnpm --filter @dev.fast/whiteboard-desktop app:run",
    "desktop:watch": "pnpm --filter @dev.fast/whiteboard-desktop app:watch",
    "desktop:package:linux": "pnpm --filter @dev.fast/whiteboard-desktop app:package:linux",
    "review": "pnpm --filter @dev.fast/whiteboard review",
    "whiteboard": "pnpm --filter @dev.fast/whiteboard whiteboard",
    "format": "oxfmt --write \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"!apps/whiteboard-desktop/code-oss/**\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"!packages/whiteboard/app/icons/dev-fast.icon/**\" \"*.json\" \".*.json\"",
    "format:check": "oxfmt --check \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"!apps/whiteboard-desktop/code-oss/**\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\" \"!packages/whiteboard/app/icons/dev-fast.icon/**\" \"*.json\" \".*.json\"",
    "lint": "oxlint --disable-nested-config .",
    "ci": "pnpm --filter @dev.fast/whiteboard-desktop app:build && pnpm --filter @dev.fast/whiteboard check:tutorial && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.63.0",
    "@types/node": "24.12.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "npm:typescript@7.0.1-rc"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.1.2"
}
