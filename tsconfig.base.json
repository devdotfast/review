{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2025 for iterator helpers, which anti-slop/no-array-filter-map
    // expects as the fix. The runtime floor is Node 24 (package.json
    // engines) and Electron 42 (Chromium 140) for the canvas.
    "lib": ["ES2025"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@dev.fast/review/authoring": [
        "./packages/progressive-review/src/authoring.ts"
      ],
      "@dev.fast/review/traces": [
        "./packages/progressive-review/src/traces-runtime.ts"
      ],
      "@dev.fast/*": ["./packages/*/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
