{
  "name": "@dev.fast/review",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "bin": {
    "review": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "onboarding.md",
    "app/dist",
    "app/src",
    "!app/src/**/*.test.ts",
    "!app/src/**/*.test.tsx",
    "!app/src/browser-test-setup.ts",
    "!app/src/**/*test-utils*",
    "dist",
    "skills",
    "plugins",
    "tutorial",
    "!tutorial/.bundle",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*test-utils*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./sharing": {
      "types": "./dist/sharing/index.d.ts",
      "import": "./dist/sharing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsdown",
    "build:tutorial-assets": "tsx scripts/build-tutorial-assets.ts",
    "ensure:tutorial-assets": "tsx scripts/ensure-tutorial-assets.ts",
    "check:tutorial": "tsx scripts/check-tutorial.ts",
    "build:workspace-deps": "pnpm --filter @dev.fast/json --filter @dev.fast/local-vcs --filter @dev.fast/review-protocol --filter @dev.fast/review-share-protocol --filter @dev.fast/trace-protocol --filter @dev.fast/trace-core build",
    "pretypecheck": "pnpm run ensure:tutorial-assets",
    "pretest": "pnpm run ensure:tutorial-assets",
    "pretest:browser": "pnpm run ensure:tutorial-assets",
    "pretest:node": "pnpm run ensure:tutorial-assets",
    "prepack": "pnpm run build && pnpm run app:desktop:build",
    "start": "tsx src/cli.ts",
    "app:desktop:build": "vite build --config app/desktop.vite.config.ts",
    "review": "tsx src/cli.ts",
    "fixtures:capture-legacy-review": "tsx scripts/capture-legacy-review-fixture.ts",
    "fixtures:legacy-review-goldens": "tsx scripts/generate-legacy-review-goldens.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.config.ts --project browser",
    "test:browser:watch": "vitest --config vitest.config.ts --project browser --browser.headless=false",
    "test:node": "vitest run --config vitest.config.ts --project shared-module-graph",
    "test:legacy-corpus": ": \"${REVIEW_LEGACY_CORPUS:?set REVIEW_LEGACY_CORPUS to a directory of legacy Review UUID folders}\" && vitest run --config vitest.config.ts src/legacy-review-corpus.test.ts",
    "test:telemetry-privacy": "vitest run --config vitest.config.ts src/ui-telemetry-events.test.ts src/error-telemetry.test.ts",
    "typecheck": "pnpm -w exec tsc --noEmit -p packages/review"
  },
  "dependencies": {
    "@dev.fast/local-vcs": "^0.1.0",
    "@dev.fast/review-share-protocol": "workspace:*",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mr_mint/elkjs-libavoid": "0.5.0",
    "@speed-highlight/core": "1.2.15",
    "@tanstack/react-table": "8.21.3",
    "@types/react": "19.2.14",
    "@xyflow/react": "12.10.2",
    "commander": "14.0.3",
    "decode-named-character-reference": "1.3.0",
    "elkjs": "0.11.1",
    "es-module-lexer": "2.1.0",
    "fuzzysort": "4.0.2",
    "hono": "4.13.5",
    "isomorphic-git": "1.38.10",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pino": "^10.3.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "semver": "7.8.5",
    "sharp": "0.35.4",
    "smol-toml": "1.8.0",
    "typescript": "6.0.3",
    "zod": "4.4.3",
    "zustand": "4.5.7",
    "diffr": "git+ssh://git@github.com/devdotfast/diffr.git#13261821ce082ca713fb4853a1d569fab30ab717"
  },
  "devDependencies": {
    "@dev.fast/json": "workspace:*",
    "@dev.fast/review-protocol": "workspace:*",
    "@dev.fast/trace-core": "workspace:*",
    "@dev.fast/trace-protocol": "workspace:*",
    "@types/node": "24.12.2",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.11",
    "pino-pretty": "^13.1.3",
    "playwright": "1.62.1",
    "tsdown": "^0.22.3",
    "tsx": "4.21.0",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "intent": {
    "version": 1,
    "repo": "devdotfast/review",
    "docs": "packages/review/skills/dev-review/SKILL.md"
  }
}
