{
	// Whiteboard Light: the Whiteboard syntax palette over the stock Light+ include.
	// Every scope the included theme colors is listed below, so none of its colors reaches the screen;
	// the include only supplies grammar coverage. Roles: keyword, type, function, ink, string, number,
	// operator, comment, inserted, deleted. Regenerated from the Whiteboard System — Syntax themes board.
	"$schema": "vscode://schemas/color-theme",
	"name": "Review Light",
	"include": "./../../theme-defaults/themes/light_plus.json",
	"semanticHighlighting": true,
	"tokenColors": [
		{
			"name": "Whiteboard: comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6B7382",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Whiteboard: keyword and storage",
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.noexcept",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.alignof",
				"keyword.operator.typeid",
				"keyword.operator.alignas",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"source.cpp keyword.operator.new",
				"source.cpp keyword.operator.delete",
				"keyword.operator.delete",
				"keyword.other.using",
				"keyword.other.directive.using",
				"keyword.other.operator",
				"entity.name.operator",
				"variable.language",
				"meta.preprocessor",
				"entity.name.function.preprocessor",
				"keyword.operator.or.regexp",
				"keyword.control.anchor.regexp",
				"meta.diff.header",
				"header"
			],
			"settings": {
				"foreground": "#2B55E6"
			}
		},
		{
			"name": "Whiteboard: type, class, tag, attribute and selector",
			"scope": [
				"entity.name.type",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"entity.name.namespace",
				"entity.other.attribute",
				"entity.name.scope-resolution",
				"entity.name.class",
				"meta.type.cast.expr",
				"meta.type.new.expr",
				"support.constant.math",
				"support.constant.dom",
				"support.constant.json",
				"punctuation.separator.namespace.ruby",
				"storage.type.numeric.go",
				"storage.type.byte.go",
				"storage.type.boolean.go",
				"storage.type.string.go",
				"storage.type.uintptr.go",
				"storage.type.error.go",
				"storage.type.rune.go",
				"storage.type.cs",
				"storage.type.generic.cs",
				"storage.type.modifier.cs",
				"storage.type.variable.cs",
				"storage.type.annotation.java",
				"storage.type.generic.java",
				"storage.type.java",
				"storage.type.object.array.java",
				"storage.type.primitive.array.java",
				"storage.type.primitive.java",
				"storage.type.token.java",
				"storage.type.groovy",
				"storage.type.annotation.groovy",
				"storage.type.parameters.groovy",
				"storage.type.generic.groovy",
				"storage.type.object.array.groovy",
				"storage.type.primitive.array.groovy",
				"storage.type.primitive.groovy",
				"entity.name.tag",
				"entity.name.tag.css",
				"entity.name.tag.less",
				"entity.name.selector",
				"entity.other.attribute-name",
				"entity.other.attribute-name.class.css",
				"source.css entity.other.attribute-name.class",
				"entity.other.attribute-name.id.css",
				"entity.other.attribute-name.parent-selector.css",
				"entity.other.attribute-name.parent.less",
				"source.css entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element.css",
				"source.css.less entity.other.attribute-name.id",
				"entity.other.attribute-name.scss"
			],
			"settings": {
				"foreground": "#0C6E8E"
			}
		},
		{
			"name": "Whiteboard: class name",
			"scope": [
				"entity.name.type.class"
			],
			"settings": {
				"foreground": "#0C6E8E",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: function, decorator and section",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"meta.decorator",
				"punctuation.decorator",
				"support.constant.handlebars",
				"source.powershell variable.other.member",
				"entity.name.operator.custom-literal",
				"support.function.git-rebase"
			],
			"settings": {
				"foreground": "#1F3F99"
			}
		},
		{
			"name": "Whiteboard: heading",
			"scope": [
				"entity.name.section",
				"markup.heading"
			],
			"settings": {
				"foreground": "#1F3F99",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: variable, property name and key",
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other",
				"variable.other.property",
				"variable.other.object.property",
				"support.variable",
				"support.variable.property",
				"meta.definition.variable.name",
				"entity.name.variable",
				"constant.other.placeholder",
				"meta.object-literal.key",
				"variable.other.constant",
				"variable.other.enummember",
				"support.type.vendored.property-name",
				"support.type.property-name",
				"support.type.property-name.json",
				"source.css variable",
				"source.coffee.embedded",
				"meta.structure.dictionary.key.python",
				"entity.name.label",
				"constant.other.option",
				"meta.embedded",
				"source.groovy.embedded",
				"string meta.image.inline.markdown",
				"variable.legacy.builtin.python",
				"meta.template.expression",
				"storage.modifier.import.java",
				"variable.language.wildcard.java",
				"storage.modifier.package.java"
			],
			"settings": {
				"foreground": "#15181E"
			}
		},
		{
			"name": "Whiteboard: string, value and regexp",
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string",
				"meta.embedded.assembly",
				"string.tag",
				"string.value",
				"string.regexp",
				"constant.regexp",
				"constant.character",
				"string.comment.buffered.block.pug",
				"string.quoted.pug",
				"string.interpolated.pug",
				"string.unquoted.plain.in.yaml",
				"string.unquoted.plain.out.yaml",
				"string.unquoted.block.yaml",
				"string.quoted.single.yaml",
				"string.quoted.double.xml",
				"string.quoted.single.xml",
				"string.unquoted.cdata.xml",
				"string.quoted.double.html",
				"string.quoted.single.html",
				"string.unquoted.html",
				"string.quoted.single.handlebars",
				"string.quoted.double.handlebars",
				"meta.preprocessor.string",
				"markup.inline.raw",
				"support.constant.property-value",
				"support.constant.font-name",
				"support.constant.media-type",
				"support.constant.media",
				"constant.other.color.rgb-value",
				"constant.other.rgb-value",
				"support.constant.color",
				"constant.character.character-class.regexp",
				"constant.other.character-class.set.regexp",
				"constant.other.character-class.regexp",
				"constant.character.set.regexp"
			],
			"settings": {
				"foreground": "#8A5A1C"
			}
		},
		{
			"name": "Whiteboard: number, unit and escape",
			"scope": [
				"constant.numeric",
				"keyword.other.unit",
				"keyword.operator.plus.exponent",
				"keyword.operator.minus.exponent",
				"meta.preprocessor.numeric",
				"constant.sha.git-rebase",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#8B3F8A"
			}
		},
		{
			"name": "Whiteboard: boolean and language constant",
			"scope": [
				"constant.language"
			],
			"settings": {
				"foreground": "#8B3F8A",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: operator and punctuation",
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.definition.tag",
				"punctuation.definition.template-expression",
				"punctuation.definition.template-expression.begin",
				"punctuation.definition.template-expression.end",
				"punctuation.section.embedded",
				"punctuation.section.embedded.begin.php",
				"punctuation.section.embedded.end.php",
				"punctuation.definition.quote.begin.markdown",
				"punctuation.definition.list.begin.markdown",
				"markup.changed",
				"punctuation.definition.group.regexp",
				"punctuation.definition.group.assertion.regexp",
				"punctuation.definition.character-class.regexp",
				"punctuation.character.set.begin.regexp",
				"punctuation.character.set.end.regexp",
				"keyword.operator.negation.regexp",
				"support.other.parenthesis.regexp",
				"keyword.operator.quantifier.regexp"
			],
			"settings": {
				"foreground": "#5D6472"
			}
		},
		{
			"name": "Whiteboard: inserted",
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#167A47"
			}
		},
		{
			"name": "Whiteboard: deleted",
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#C93A27"
			}
		},
		{
			"name": "Whiteboard: invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#C93A27",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Whiteboard: markup bold",
			"scope": [
				"markup.bold",
				"strong"
			],
			"settings": {
				"foreground": "#15181E",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: markup italic",
			"scope": [
				"markup.italic",
				"emphasis"
			],
			"settings": {
				"foreground": "#15181E",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Whiteboard: markup underline",
			"scope": [
				"markup.underline"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"name": "Whiteboard: markup strikethrough",
			"scope": [
				"markup.strikethrough"
			],
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Whiteboard: link",
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#2B55E6",
				"fontStyle": "underline"
			}
		}
	],
	"semanticTokenColors": {
		"newOperator": "#2B55E6",
		"stringLiteral": "#8A5A1C",
		"customLiteral": "#1F3F99",
		"numberLiteral": "#8B3F8A"
	},
	"colors": {
		"editor.background": "#FFFFFF",
		"editorWidget.background": "#F3F4F6",
		"panel.border": "#D8DBE1",
		"editorWidget.border": "#B9BEC7",
		"focusBorder": "#2B55E6",
		"editorGroupHeader.tabsBackground": "#F3F4F6",
		"titleBar.activeBackground": "#F3F4F6",
		"titleBar.inactiveBackground": "#F3F4F6",
		"diffEditor.insertedLineBackground": "#1B9A5716",
		"diffEditor.insertedTextBackground": "#1B9A5733",
		"diffEditor.removedLineBackground": "#D8402C16",
		"diffEditor.removedTextBackground": "#D8402C33",
		"widget.shadow": "#15181E1A",
		"editorHoverWidget.border": "#B9BEC7",
		"editorHoverWidget.background": "#FFFFFF",
		"sideBar.background": "#F3F4F6",
		"diffEditor.diagonalFill": "#D8DBE180",
		"diffEditor.unchangedCodeBackground": "#00000000",
		"diffEditor.unchangedRegionBackground": "#FFFFFF",
		"diffEditor.unchangedRegionForeground": "#CDD1D8",
		"diffEditor.unchangedRegionShadow": "#00000000",
		"gitDecoration.addedResourceForeground": "#1B9A57",
		"gitDecoration.modifiedResourceForeground": "#C98A0B",
		"gitDecoration.renamedResourceForeground": "#5D6472",
		"gitDecoration.deletedResourceForeground": "#D8402C",
		"multiDiffEditor.border": "#D8DBE1",
		"multiDiffEditor.headerBackground": "#F3F4F6",
		"icon.foreground": "#5D6472",
		"editor.selectionBackground": "#2B55E629",
		"editor.lineHighlightBackground": "#F3F4F6",
		"scrollbarSlider.background": "#B9BEC780",
		"toolbar.hoverBackground": "#E9EBEF",
		"list.inactiveSelectionBackground": "#E9EBEF",
		"list.activeSelectionForeground": "#15181E",
		"list.activeSelectionBackground": "#2B55E616",
		"list.hoverBackground": "#E9EBEF",
		"input.background": "#FFFFFF",
		"editorGutter.background": "#FFFFFF",
		"editorLineNumber.activeForeground": "#5D6472",
		"editorLineNumber.foreground": "#CDD1D8",
		"foreground": "#15181E",
		"disabledForeground": "#9AA0AB",
		"descriptionForeground": "#5D6472",
		"editor.foreground": "#15181E",
		"editorCursor.foreground": "#2B55E6",
		"editorBracketMatch.background": "#2B55E616",
		"editorBracketMatch.border": "#2B55E638",
		"editorIndentGuide.background1": "#D8DBE1",
		"editorIndentGuide.activeBackground1": "#B9BEC7",
		"editorWhitespace.foreground": "#CDD1D8",
		"editorBracketHighlight.foreground1": "#5D6472",
		"editorBracketHighlight.foreground2": "#5D6472",
		"editorBracketHighlight.foreground3": "#5D6472",
		"editorBracketHighlight.foreground4": "#5D6472",
		"editorBracketHighlight.foreground5": "#5D6472",
		"editorBracketHighlight.foreground6": "#5D6472",
		"editorBracketHighlight.unexpectedBracket.foreground": "#C93A27"
	}
}
