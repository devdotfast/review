{
  "name": "@dev.fast/whiteboard",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devdotfast/review.git",
    "directory": "packages/review"
  },
  "bin": {
    "review": "./dist/cli.js",
    "whiteboard": "./dist/whiteboard-cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "onboarding.md",
    "dist",
    "skills",
    "plugins",
    "tutorial",
    "!tutorial/.bundle",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*test-utils*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./sharing": {
      "types": "./dist/sharing/index.d.ts",
      "import": "./dist/sharing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm run build:workspace-deps",
    "ensure:diffr": "diffr-fetch --into bin",
    "build": "tsdown",
    "build:tutorial-assets": "tsx scripts/build-tutorial-assets.ts",
    "ensure:tutorial-assets": "tsx scripts/ensure-tutorial-assets.ts",
    "check:tutorial": "tsx scripts/check-tutorial.ts",
    "build:workspace-deps": "pnpm --filter @dev.fast/json --filter @dev.fast/local-vcs --filter @dev.fast/review-protocol --filter @dev.fast/review-share-protocol --filter @dev.fast/trace-protocol --filter @dev.fast/trace-core build",
    "pretypecheck": "pnpm run ensure:tutorial-assets",
    "pretest": "pnpm run ensure:tutorial-assets",
    "pretest:node": "pnpm run ensure:tutorial-assets",
    "prepack": "pnpm run build",
    "start": "tsx src/cli.ts",
    "review": "tsx src/cli.ts",
    "whiteboard": "tsx src/whiteboard-cli.ts",
    "fixtures:capture-legacy-review": "tsx scripts/capture-legacy-review-fixture.ts",
    "fixtures:legacy-review-goldens": "tsx scripts/generate-legacy-review-goldens.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:node": "vitest run --config vitest.config.ts --project shared-module-graph",
    "test:legacy-corpus": ": \"${REVIEW_LEGACY_CORPUS:?set REVIEW_LEGACY_CORPUS to a directory of legacy Review UUID folders}\" && vitest run --config vitest.config.ts src/legacy-review-corpus.test.ts",
    "test:telemetry-privacy": "vitest run --config vitest.config.ts src/ui-telemetry-events.test.ts src/error-telemetry.test.ts",
    "typecheck": "pnpm -w exec tsc --noEmit -p packages/review",
    "test:integration:diffr": "pnpm run build:workspace-deps && pnpm run ensure:diffr --required && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "14.0.3",
    "es-module-lexer": "2.1.0",
    "fuzzysort": "4.0.2",
    "hono": "4.13.5",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pino": "^10.3.1",
    "semver": "7.8.5",
    "sharp": "0.35.4",
    "smol-toml": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dev.fast/diffr": "0.1.1",
    "@dev.fast/json": "workspace:*",
    "@dev.fast/local-vcs": "^0.1.0",
    "@dev.fast/review-protocol": "workspace:*",
    "@dev.fast/review-share-protocol": "workspace:*",
    "@dev.fast/trace-core": "workspace:*",
    "@dev.fast/trace-protocol": "workspace:*",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/semver": "7.7.1",
    "isomorphic-git": "1.38.10",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.22.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "intent": {
    "version": 1,
    "repo": "devdotfast/review",
    "docs": "packages/review/skills/whiteboard/SKILL.md"
  }
}
