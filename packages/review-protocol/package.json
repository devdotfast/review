{
  "name": "@dev.fast/review-protocol",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bug-report": {
      "types": "./dist/bug-report.d.ts",
      "import": "./dist/bug-report.js",
      "default": "./dist/bug-report.js"
    }
  },
  "scripts": {
    "build": "pnpm -w exec tsc -p packages/review-protocol/tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "pnpm -w exec tsc -p packages/review-protocol/tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
