    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "git-url-parse": "16.1.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/proper-lockfile": "4.1.4",
    "tsdown": "^0.22.3",
    "typescript": "npm:@typescript/typescript6@6.0.1",
    "typescript-7": "npm:typescript@7.0.1-rc",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
