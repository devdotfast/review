{
  "name": "@dev.fast/review",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "bin": {
    "review": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "onboarding.md",
    "app/dist",
    "app/src",
    "!app/src/**/*.test.ts",
    "!app/src/**/*.test.tsx",
    "dist",
    "skills",
    "tutorial",
    "src",
    "!src/**/*.test.ts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./desktop-server": {
      "types": "./dist/desktop-server.d.ts",
      "import": "./dist/desktop-server.js"
    },
    "./software-map": {
      "types": "./dist/software-map-model.d.ts",
      "import": "./dist/software-map-model.js"
    },
    "./software-map-topology-diff": {
      "types": "./dist/software-map-topology-diff.d.ts",
      "import": "./dist/software-map-topology-diff.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsdown",
    "build:tutorial-assets": "tsx scripts/build-tutorial-assets.ts",
    "check:tutorial": "tsx scripts/check-tutorial.ts",
    "build:workspace-deps": "node ../../scripts/run-workspace-build.mjs pnpm --filter @dev.fast/local-vcs --filter @dev.fast/review-protocol build",
    "pretypecheck": "pnpm run build:workspace-deps",
    "pretest": "pnpm run build:workspace-deps",
    "preapp:desktop:build": "pnpm run build:workspace-deps",
    "prepack": "pnpm run build && pnpm run app:desktop:build",
    "start": "tsx src/cli.ts",
    "app:desktop:build": "vite build --config app/desktop.vite.config.ts",
    "eval:scroll": "tsx scripts/scroll-eval.ts",
    "map": "tsx src/map-cli-entry.ts",
    "review": "tsx src/cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:telemetry-privacy": "vitest run --config vitest.config.ts src/ui-telemetry-events.test.ts src/error-telemetry.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "7.29.7",
    "@dev.fast/local-vcs": "^0.1.0",
    "@hono/node-server": "2.0.12",
    "@mdx-js/mdx": "3.1.1",
    "@mr_mint/elkjs-libavoid": "0.5.0",
    "@speed-highlight/core": "1.2.15",
    "@tanstack/react-table": "8.21.3",
    "@types/react": "19.2.14",
    "@xyflow/react": "12.10.2",
    "commander": "14.0.3",
    "elkjs": "0.11.1",
    "es-module-lexer": "2.1.0",
    "esbuild": "0.28.1",
    "fuzzysort": "4.0.2",
    "hono": "4.12.32",
    "isomorphic-git": "1.38.10",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "^3.1.1",
    "semver": "7.8.5",
    "source-map": "^0.7.6",
    "typescript": "6.0.3",
    "write-file-atomic": "8.0.0",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@dev.fast/review-protocol": "workspace:*",
    "@types/estree": "1.0.8",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.12.2",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "tsdown": "^0.22.3",
    "tsx": "4.21.0",
    "typescript-7": "npm:typescript@7.0.1-rc",
    "undici": "7.28.0",
    "vite": "8.0.16",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "intent": {
    "version": 1,
    "repo": "devdotfast/review",
    "docs": "packages/progressive-review/skills/dev-review/SKILL.md"
  }
}
